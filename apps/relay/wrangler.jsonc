// Relais WebSocket + hébergement de la PWA (et de la visionneuse des projets partagés), en un seul Worker.
// Projets partagés : bucket R2 vibescreener-shares (wrangler r2 bucket create vibescreener-shares). La tâche planifiée
// efface chaque jour les partages restés 30 jours sans modification, comme le dit la page Confidentialité ; pas de
// règle d'expiration sur le bucket, qui effacerait les images d'un projet encore actif.
// Deux adresses, mêmes rooms : relay.vibescreener.dev (domaine provisoire) pour les nouvelles
// versions, et pastille.vibescreener.workers.dev pour les apps et tablettes appairées avant :
// ne jamais retirer workers_dev ni renommer le Worker.
{
  "name": "pastille",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "relay.vibescreener.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../pwa/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/ws/*", "/share/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "r2_buckets": [{ "binding": "SHARES", "bucket_name": "vibescreener-shares" }],
  "triggers": { "crons": ["30 3 * * *"] }
}
