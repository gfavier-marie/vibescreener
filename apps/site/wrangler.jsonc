// Site public (landing, pages légales) en cinq langues : fichiers statiques produits par build.ts, sans code Worker.
{
  "name": "vibescreener-site",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "vibescreener.dev", "custom_domain": true }]
}
